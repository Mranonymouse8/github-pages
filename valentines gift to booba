<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Valentine's Surprise</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      height: 100vh;
      background: linear-gradient(to right, #ffdde1, #b3e0ff);
      font-family: Arial, sans-serif;
      text-align: center;
      position: relative;
    }

    .bg-hearts {
      position: absolute;
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
      z-index: 0;
      pointer-events: none;
    }

    .bg-heart {
      position: absolute;
      font-size: 22px; /* Slightly bigger */
      opacity: 0.4; /* More visible */
    }

    .corner-heart {
      position: absolute;
      font-size: 30px;
    }
    .corner-heart.top-left,
    .corner-heart.bottom-left {
      color: #b3e0ff; /* Blue on the left */
    }
    .corner-heart.top-right,
    .corner-heart.bottom-right {
      color: #ffb6c1; /* Pink on the right */
    }

    .corner-heart.top-left {
      top: 10px;
      left: 10px;
    }
    .corner-heart.top-right {
      top: 10px;
      right: 10px;
    }
    .corner-heart.bottom-left {
      bottom: 10px;
      left: 10px;
    }
    .corner-heart.bottom-right {
      bottom: 10px;
      right: 10px;
    }

    .pour-hearts {
      position: absolute;
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
      z-index: 2;
      pointer-events: none;
    }

    .pour-heart {
      position: absolute;
      font-size: 24px;
      opacity: 0.8; /* More visible */
      animation: drop 2s forwards;
    }

    @keyframes drop {
      0% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      100% {
        opacity: 0;
        transform: translateY(100vh) scale(1.5);
      }
    }

    .envelope-container {
      position: relative;
      z-index: 1;
    }

    .to-booba {
      font-size: 28px;
      font-weight: bold;
      color: #ffb6c1;
      text-shadow: 1px 1px 2px #b3e0ff;
      margin-bottom: 15px;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.1);
      }
      100% {
        transform: scale(1);
      }
    }

    .envelope {
      width: 220px;
      height: 160px;
      background: #ffb6c1;
      border: 2px solid #b3e0ff;
      border-radius: 10px;
      position: relative;
      cursor: pointer;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 22px;
      font-weight: bold;
      color: #b3e0ff;
      text-shadow: 1px 1px 2px #ff99aa;
      transition: transform 0.3s, box-shadow 0.3s;
    }

    .flap {
      width: 220px;
      height: 110px;
      background: #ff99aa;
      position: absolute;
      top: 0;
      clip-path: polygon(0 0, 100% 0, 50% 100%);
      transition: transform 0.5s ease-in-out;
    }

    /* Message container with fade-in/out effect */
    .message {
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: white;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
      z-index: 10;
      text-align: center;
      width: 300px;
    }
    .message.show {
      opacity: 1;
      visibility: visible;
    }
    .message p {
      font-size: 16px;
      color: black;
      line-height: 1.4;
      margin: 10px 0;
      text-align: left;
    }
    .close-btn {
      margin-top: 15px;
      padding: 8px 15px;
      background: #ffb6c1;
      border: none;
      color: white;
      font-weight: bold;
      cursor: pointer;
      border-radius: 5px;
      transition: background 0.3s;
    }
    .close-btn:hover {
      background: #ff99aa;
    }
  </style>
</head>
<body>
  <div class="bg-hearts" id="bg-hearts"></div>
  <div class="pour-hearts" id="pour-hearts"></div>

  <div class="corner-heart top-left">❤</div>
  <div class="corner-heart top-right">❤</div>
  <div class="corner-heart bottom-left">❤</div>
  <div class="corner-heart bottom-right">❤</div>

  <div class="envelope-container">
    <div class="to-booba">TO BOOBA</div>
    <div class="envelope" onclick="openLetter()">
      <div class="flap" id="flap"></div>
    </div>
  </div>

  <div class="message" id="message">
    <p>
      My booba, at no stage have I ever been bored of you, even when you are angry or happy with me.
      I have always wanted you by my side, no matter how distant I may seem; I cannot do it without you
      anymore. I love you greater than life itself.
    </p>
    <p>
      I still remember the first time I saw you. I couldn't believe that such a woman exists, and yet, even
      though I had my reservations, I still couldn't resist just looking at you. My opinion of you will always
      hold more merit than any justified action.
    </p>
    <p>
      I will sacrifice the world for you if it comes down to it. I wouldn't replace you even if I were given
      infinite chances, my love.
    </p>
    <button class="close-btn" onclick="closeLetter()">Close Letter</button>
  </div>

  <script>
    function generateBackgroundHearts() {
      const bgHeartsContainer = document.getElementById("bg-hearts");
      const colors = ["#ffb6c1", "#b3e0ff"];
      for (let i = 0; i < 100; i++) {
        const heart = document.createElement("div");
        heart.classList.add("bg-heart");
        heart.textContent = "❤";
        heart.style.left = Math.random() * 100 + "%";
        heart.style.top = Math.random() * 100 + "%";
        heart.style.color = colors[i % 2];
        bgHeartsContainer.appendChild(heart);
      }
    }

    function createPouringHearts() {
      const pourContainer = document.getElementById("pour-hearts");
      const colors = ["#ffb6c1", "#b3e0ff"];
      for (let i = 0; i < 30; i++) {
        const heart = document.createElement("div");
        heart.classList.add("pour-heart");
        heart.textContent = "❤";
        heart.style.left = (Math.random() * 80 + 10) + "%";
        heart.style.color = colors[i % 2];
        heart.style.animationDelay = (Math.random() * 0.5) + "s";
        pourContainer.appendChild(heart);
      }
      setTimeout(() => (pourContainer.innerHTML = ""), 2500);
    }

    function openLetter() {
      document.getElementById("flap").style.transform = "rotateX(180deg)";
      setTimeout(() => {
        document.querySelector(".envelope").style.display = "none";
        const messageEl = document.getElementById("message");
        messageEl.classList.add("show");
        createPouringHearts();
      }, 500);
    }

    function closeLetter() {
      document.getElementById("message").classList.remove("show");
      document.querySelector(".envelope").style.display = "flex";
      // Reset flap position for next opening
      document.getElementById("flap").style.transform = "rotateX(0deg)";
    }

    generateBackgroundHearts();
  </script>
</body>
</html>
